{
  "name": "docfacts",
  "version": "0.1.0",
  "description": "Check a technical document against the reference it was written from. Reports commands, flags, variables, exit codes and endpoints the reference does not support. Runs nothing, sends nothing.",
  "keywords": ["documentation", "technical-writing", "verification", "fact-checking", "hallucination", "cli", "docs-as-code"],
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20.0.0" },
  "bin": {
    "docfacts": "dist/docverify.js",
    "docverify": "dist/docverify.js"
  },
  "exports": {
    ".": { "types": "./dist/check.d.ts", "import": "./dist/check.js" }
  },
  "files": ["dist/", "README.md", "PRIVACY.md", "CHANGELOG.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  }
}
